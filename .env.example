PORT=5000
NODE_ENV=development

# Replica set is required for order and payment transactions.
# Local Windows (npm run db:up): mongodb://127.0.0.1:27018/vegetable_marketplace?replicaSet=rs0
# Docker Compose Mongo: mongodb://127.0.0.1:27017/vegetable_marketplace?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27018/vegetable_marketplace?replicaSet=rs0

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Optional. Leave empty to run without Redis.
REDIS_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

FRONTEND_URL=http://localhost:3000

LOG_LEVEL=info
